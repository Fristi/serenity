// Scent-guided breathing UI.
//
// Three screens live in this single window:
//   start     - landing screen with "Start New Session" and "Customize"
//   session   - breathing exercise with a close (x) button at the bottom
//   customize - a stack of settings pages (duration, pattern, scent dispenser)
//
// The screen is selected by the `screen` state property. Screens are wrapped in
// `if` blocks so Slint only instantiates the one that is visible.

enum Screen {
    start,
    session,
    customize,
}

// Pages of the Customize stack. Internal: the host never navigates these, and
// the page resets to the menu each time Customize is opened.
enum CustomizePage {
    root,
    duration,
    pattern,
    pattern-edit,
    scent,
    scent-link,
}

// Audible cues. The UI only names them; a host turns them into samples.
export enum Sound {
    breath-in,
    breath-out,
    hold,
    ding,
}

// "6-0-2-0" = inhale-hold-exhale-hold, in seconds. The holds are named for the
// phase they follow: `hold-inhale` is the hold after the inhale.
struct BreathPattern {
    name: string,
    hint: string,
    inhale: int,
    hold-inhale: int,
    exhale: int,
    hold-exhale: int,
    accent: color,
}

// Persisted settings, and the single source of truth for the breathing rhythm.
// There is no stored pattern index: a preset "matches" when its numbers equal
// these, otherwise the rhythm is custom.
//
// Mirrored to Rust as `ui::Settings`; field names become snake_case there
// (`hold_inhale`, `hold_exhale`).
export struct Settings {
    minutes: int,
    inhale: int,
    hold-inhale: int,
    exhale: int,
    hold-exhale: int,
    scent-on: bool,
}

component SectionLabel inherits Text {
    color: #6f7b93;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    vertical-alignment: center;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    callback clicked;

    height: 68px;
    border-radius: 18px;
    // Solid fill: the software renderer draws gradients as plain rectangles and
    // ignores the rounded clip, so gradients cannot be used on rounded shapes.
    background: root.primary ? #4facfe : #ffffff0d;
    border-width: 1px;
    border-color: root.primary ? #ffffff00 : #ffffff20;

    Text {
        text: root.text;
        color: root.primary ? #0d0d12 : #ffffff;
        font-size: 17px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    opacity: ta.pressed ? 0.75 : 1;
    // animate opacity { duration: 120ms; }
}

component CloseButton inherits Rectangle {
    callback clicked;

    width: 68px;
    height: 68px;
    border-radius: 34px;
    background: #ffffff12;
    border-width: 1px;
    border-color: #ffffff20;

    Text {
        text: "×";
        y: -2px;
        font-size: 38px;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    opacity: ta.pressed ? 0.6 : 1;
    // animate opacity { duration: 120ms; }
}

// Title row for a Customize sub-page. The back region is a full 56px square
// rather than just the glyph: the arrow sits at the very edge of the panel,
// where a small target is hardest to hit.
component PageHeader inherits Rectangle {
    in property <string> title;
    callback back;

    height: 56px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 56px;
            height: 56px;

            Text {
                text: "‹";
                y: -3px;
                font-size: 32px;
                font-weight: 300;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ta := TouchArea {
                clicked => { root.back(); }
            }
            opacity: ta.pressed ? 0.6 : 1;
        }

        Text {
            text: root.title;
            font-size: 24px;
            font-weight: 300;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

// One row of a Customize menu: title on the left, current value on the right.
// The whole row is the touch target.
component MenuRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> selected: false;
    callback picked;

    height: 72px;
    border-radius: 16px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: root.selected ? #4facfe : #ffffff14;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        alignment: center;

        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Text {
            text: root.value;
            font-size: 14px;
            color: root.selected ? #4facfe : #8f9bb3;
            vertical-alignment: center;
        }

        Text {
            text: "›";
            y: -2px;
            font-size: 26px;
            font-weight: 300;
            color: #ffffff40;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.picked(); }
    }
    opacity: ta.pressed ? 0.75 : 1;
}

component StepButton inherits Rectangle {
    in property <string> label;
    callback clicked;

    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: #ffffff0f;
    border-width: 1px;
    border-color: #ffffff1a;

    Text {
        text: root.label;
        font-size: 26px;
        font-weight: 300;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    opacity: ta.pressed ? 0.6 : 1;
}

// "- value +" control. Clamps here so every caller gets a valid range for free.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <string> suffix;
    in property <int> min: 1;
    in property <int> max: 60;
    callback changed(int);

    height: 72px;

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        StepButton {
            label: "-";
            clicked => { root.changed(Math.max(root.min, root.value - 1)); }
        }

        Text {
            text: root.value + " " + root.suffix;
            font-size: 26px;
            font-weight: 300;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        StepButton {
            label: "+";
            clicked => { root.changed(Math.min(root.max, root.value + 1)); }
        }
    }
}

// Label plus stepper, for the four steps of a custom rhythm.
component StepRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> min: 0;
    callback changed(int);

    height: 72px;
    border-radius: 16px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: #ffffff14;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        Stepper {
            value: root.value;
            suffix: "s";
            min: root.min;
            max: 60;
            changed(v) => { root.changed(v); }
        }
    }
}

// ---------------------------------------------------------------------------
// Start screen
// ---------------------------------------------------------------------------

component StartScreen inherits Rectangle {
    in property <string> pattern-name;
    in property <string> pattern-numbers;
    callback start-clicked;
    callback customize-clicked;

    property <bool> breathe: false;
    property <length> hero-size: root.breathe ? 196px : 156px;
    // animate hero-size { duration: 4000ms; easing: ease-in-out; }

    Timer {
        interval: 4s;
        running: true;
        triggered() => { root.breathe = !root.breathe; }
    }

    VerticalLayout {
        padding-top: 30px;
        padding-left: 30px;
        padding-right: 30px;
        padding-bottom: 16px;
        spacing: 0px;

        Text {
            text: "MINDFUL SCENT";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            color: #6f7b93;
        }
        Text {
            text: "Serenity";
            font-size: 50px;
            font-weight: 300;
            color: #ffffff;
        }
        Text {
            text: "Scent-guided breathing sessions";
            font-size: 14px;
            color: #8f9bb3;
        }

        // Small gap under the subtitle; the hero below absorbs the spare height.
        Rectangle { height: 8px; }

        // Decorative breathing hero
        Rectangle {
            vertical-stretch: 1;
            // Taller buttons leave less room than before, so the hero floor is
            // lower; it still absorbs whatever height is left over.
            min-height: 120px;

            Rectangle {
                width: 238px;
                height: 238px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 119px;
                border-width: 1px;
                border-color: #ffffff10;
            }
            Rectangle {
                width: 196px;
                height: 196px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 98px;
                opacity: 0.10;
                background: #4facfe;
            }
            Rectangle {
                width: root.hero-size;
                height: root.hero-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                opacity: 0.24;
                background: #4facfe;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.pattern-name;
                    font-size: 19px;
                    font-weight: 600;
                    color: #ffffff;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.pattern-numbers;
                    font-size: 13px;
                    letter-spacing: 2px;
                    color: #9fb4cd;
                    horizontal-alignment: center;
                }
            }
        }

        ActionButton {
            text: "Start New Session";
            clicked => { root.start-clicked(); }
        }
        Rectangle { height: 12px; }
        ActionButton {
            text: "Customize";
            primary: false;
            clicked => { root.customize-clicked(); }
        }

        Text {
            height: 36px;
            text: "Powered by SiFli-rs";
            font-size: 12px;
            color: #5f6a7f;
            horizontal-alignment: center;
            vertical-alignment: bottom;
        }
    }
}

// ---------------------------------------------------------------------------
// Session screen
// ---------------------------------------------------------------------------

component SessionScreen inherits Rectangle {
    in property <string> pattern-name;
    in property <int> remaining;
    in property <int> total;
    in property <int> phase;
    in property <int> phase-seconds;
    in property <length> ring-size;
    in property <duration> anim-duration;
    in property <string> phase-label;
    in property <color> phase-color;
    in property <bool> finished;
    callback close-clicked;

    property <float> progress: root.total > 0 ? (root.remaining * 1.0) / root.total : 0;

    VerticalLayout {
        padding-top: 30px;
        padding-left: 30px;
        padding-right: 30px;
        padding-bottom: 16px;
        spacing: 0px;

        HorizontalLayout {
            height: 26px;
            alignment: space-between;
            Text {
                text: root.pattern-name;
                font-size: 15px;
                font-weight: 600;
                color: #ffffff;
                vertical-alignment: center;
            }
            Text {
                text: root.finished ? "Complete" : root.time-remaining();
                font-size: 15px;
                font-weight: 600;
                color: root.finished ? #69f0ae : #8f9bb3;
                vertical-alignment: center;
            }
        }

        // Session progress
        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: #ffffff14;

            Rectangle {
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: parent.border-radius;
                background: #4facfe;
                // animate width { duration: 300ms; }
            }
        }

        // Breathing visual
        Rectangle {
            vertical-stretch: 1;
            min-height: 260px;

            Rectangle {
                width: 238px;
                height: 238px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 119px;
                border-width: 1px;
                border-color: #ffffff12;
            }

            Rectangle {
                width: root.ring-size;
                height: root.ring-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                opacity: 0.20;
                background: #4facfe;
                // animate width { duration: root.anim-duration; easing: ease-in-out; }
                // animate height { duration: root.anim-duration; easing: ease-in-out; }

                Rectangle {
                    width: parent.width - 26px;
                    height: parent.height - 26px;
                    x: 13px;
                    y: 13px;
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: #ffffff30;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: root.finished ? "Session complete" : root.phase-label;
                    font-size: 15px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    color: root.finished ? #69f0ae : root.phase-color;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: root.finished ? "✓" : root.phase-seconds;
                    font-size: 68px;
                    font-weight: 200;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: root.finished ? "well done" : "seconds";
                    font-size: 12px;
                    color: #ffffff60;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Close button, centered at the bottom
        HorizontalLayout {
            height: 68px;
            alignment: center;
            CloseButton {
                clicked => { root.close-clicked(); }
            }
        }
    }

    pure function pad2(n: int) -> string {
        return n < 10 ? "0" + n : "" + n;
    }

    pure function time-remaining() -> string {
        return root.pad2(Math.mod(root.remaining, 3600) / 60) + ":" + root.pad2(Math.mod(root.remaining, 60));
    }
}

// ---------------------------------------------------------------------------
// Customize screen (a stack of pages)
// ---------------------------------------------------------------------------

component CustomizeScreen inherits Rectangle {
    in-out property <int> minutes;
    in-out property <int> inhale;
    in-out property <int> hold-inhale;
    in-out property <int> exhale;
    in-out property <int> hold-exhale;
    in property <[BreathPattern]> patterns;
    in-out property <bool> scent-on;
    // Derived by MainWindow: the preset whose numbers match, or -1 when custom.
    in property <int> matched-pattern: -1;
    in property <string> preset-name;
    callback back-clicked;

    // Lives here rather than in MainWindow so opening Customize always starts
    // at the menu: the screen is re-instantiated by the `if` in MainWindow.
    property <CustomizePage> page: CustomizePage.root;

    VerticalLayout {
        padding-top: 24px;
        padding-left: 30px;
        padding-right: 30px;
        padding-bottom: 20px;
        spacing: 0px;

        if root.page == CustomizePage.root : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Customize";
                back => { root.back-clicked(); }
            }

            Rectangle { height: 14px; }

            MenuRow {
                title: "Duration";
                value: root.minutes + " min";
                picked => { root.page = CustomizePage.duration; }
            }
            Rectangle { height: 10px; }
            MenuRow {
                title: "Pattern";
                value: root.preset-name;
                picked => { root.page = CustomizePage.pattern; }
            }
            Rectangle { height: 10px; }
            MenuRow {
                title: "Scent Dispenser";
                value: root.scent-on ? "On" : "Off";
                picked => { root.page = CustomizePage.scent; }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }

        if root.page == CustomizePage.duration : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Duration";
                back => { root.page = CustomizePage.root; }
            }

            Rectangle { height: 18px; }
            SectionLabel { text: "DURATION IN MINUTES"; }
            Rectangle { height: 10px; }

            Rectangle {
                height: 96px;
                border-radius: 16px;
                background: #ffffff0a;
                border-width: 1px;
                border-color: #ffffff14;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Stepper {
                        value: root.minutes;
                        suffix: "min";
                        min: 1;
                        max: 60;
                        changed(v) => { root.minutes = v; }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }

        if root.page == CustomizePage.pattern : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Pattern";
                back => { root.page = CustomizePage.root; }
            }

            Rectangle { height: 12px; }

            VerticalLayout {
                spacing: 8px;

                for p[i] in root.patterns : MenuRow {
                    title: p.name;
                    value: p.inhale + "-" + p.hold-inhale + "-" + p.exhale + "-" + p.hold-exhale;
                    selected: i == root.matched-pattern;
                    picked => {
                        root.inhale = p.inhale;
                        root.hold-inhale = p.hold-inhale;
                        root.exhale = p.exhale;
                        root.hold-exhale = p.hold-exhale;
                    }
                }
            }

            Rectangle { height: 14px; }

            ActionButton {
                text: "Customize pattern";
                primary: false;
                clicked => { root.page = CustomizePage.pattern-edit; }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }

        if root.page == CustomizePage.pattern-edit : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Customize pattern";
                back => { root.page = CustomizePage.pattern; }
            }

            Rectangle { height: 12px; }

            VerticalLayout {
                spacing: 8px;

                // Inhale and exhale must be at least one second: a rhythm of all
                // zeros would leave the session with no phase to advance to.
                StepRow {
                    label: "1. Inhale";
                    value: root.inhale;
                    min: 1;
                    changed(v) => { root.inhale = v; }
                }
                StepRow {
                    label: "2. Hold";
                    value: root.hold-inhale;
                    changed(v) => { root.hold-inhale = v; }
                }
                StepRow {
                    label: "3. Exhale";
                    value: root.exhale;
                    min: 1;
                    changed(v) => { root.exhale = v; }
                }
                StepRow {
                    label: "4. Hold";
                    value: root.hold-exhale;
                    changed(v) => { root.hold-exhale = v; }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }

        // The scent dispenser has no host port yet. Its pages exist so the
        // navigation is in place, but every control on them is inert.
        if root.page == CustomizePage.scent : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Scent Dispenser";
                back => { root.page = CustomizePage.root; }
            }

            Rectangle { height: 18px; }
            SectionLabel { text: root.scent-on ? "DISPENSER ON" : "DISPENSER OFF"; }
            Rectangle { height: 10px; }

            ActionButton {
                text: "Turn off";
                primary: false;
            }
            Rectangle { height: 12px; }
            ActionButton {
                text: "Link";
                primary: false;
                clicked => { root.page = CustomizePage.scent-link; }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }

        if root.page == CustomizePage.scent-link : VerticalLayout {
            spacing: 0px;

            PageHeader {
                title: "Link";
                back => { root.page = CustomizePage.scent; }
            }

            Rectangle { height: 18px; }

            Text {
                text: "Point the remote of the dispenser at this device and press its ON/OFF button. Once the infrared signal is detected, the Link button becomes active.";
                wrap: word-wrap;
                font-size: 15px;
                color: #8f9bb3;
            }

            Rectangle { height: 18px; }

            ActionButton {
                text: "Link";
                // Dimmed: nothing can be linked until the dispenser port exists.
                opacity: 0.4;
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}

// ---------------------------------------------------------------------------
// Root window / screen switch
// ---------------------------------------------------------------------------

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    title: "Serenity";

    background: @linear-gradient(180deg, #1e2a45 0%, #0d0d12 100%);

    in-out property <Screen> screen: Screen.start;

    // Host port: fired on every phase change and once when the session ends.
    callback play-sound(Sound);
    // Host port: fired whenever a persisted setting changes, including when the
    // host applies settings loaded at startup.
    callback settings-changed(Settings);

    // Host entry point: start straight into a session from outside the UI.
    public function start-session-now() {
        root.start-session();
    }

    // Host entry point: pick a preset by index. Out-of-range indices are
    // ignored so a stale stored value cannot produce a bad rhythm.
    public function select-pattern(index: int) {
        if index < 0 || index >= root.patterns.length {
            return;
        }
        root.inhale = root.patterns[index].inhale;
        root.hold-inhale = root.patterns[index].hold-inhale;
        root.exhale = root.patterns[index].exhale;
        root.hold-exhale = root.patterns[index].hold-exhale;
    }

    // Reference rhythms. None of them is selected state: picking one copies its
    // numbers into the settings below.
    property <[BreathPattern]> patterns: [
        { name: "Awake", hint: "Morning energy", inhale: 6, hold-inhale: 0, exhale: 2, hold-exhale: 0, accent: #fce38a },
        { name: "Deep Calm", hint: "Stress relief", inhale: 4, hold-inhale: 7, exhale: 8, hold-exhale: 0, accent: #4facfe },
        { name: "Box", hint: "Steady focus", inhale: 4, hold-inhale: 4, exhale: 4, hold-exhale: 4, accent: #69f0ae },
    ];

    // The persisted settings. Defaults are the "Awake" rhythm.
    in-out property <int> minutes: 10;
    in-out property <int> inhale: 6;
    in-out property <int> hold-inhale: 0;
    in-out property <int> exhale: 2;
    in-out property <int> hold-exhale: 0;
    in-out property <bool> scent-on: false;

    // Session state
    property <int> phase: 0;
    property <int> phase-seconds: 0;
    property <int> remaining: 0;
    property <int> session-total: 0;
    property <bool> running: false;
    property <bool> finished: false;
    property <bool> arming: false;
    property <length> ring-size: 150px;

    // Index of the preset whose numbers equal the settings, or -1 when custom.
    pure function preset-index() -> int {
        if root.patterns[0].inhale == root.inhale
            && root.patterns[0].hold-inhale == root.hold-inhale
            && root.patterns[0].exhale == root.exhale
            && root.patterns[0].hold-exhale == root.hold-exhale {
            return 0;
        }
        if root.patterns[1].inhale == root.inhale
            && root.patterns[1].hold-inhale == root.hold-inhale
            && root.patterns[1].exhale == root.exhale
            && root.patterns[1].hold-exhale == root.hold-exhale {
            return 1;
        }
        if root.patterns[2].inhale == root.inhale
            && root.patterns[2].hold-inhale == root.hold-inhale
            && root.patterns[2].exhale == root.exhale
            && root.patterns[2].hold-exhale == root.hold-exhale {
            return 2;
        }
        return -1;
    }

    pure function preset-name() -> string {
        return root.preset-index() < 0 ? "Custom" : root.patterns[root.preset-index()].name;
    }

    // "6-0-2-0": inhale-hold-exhale-hold.
    pure function rhythm() -> string {
        return root.inhale + "-" + root.hold-inhale + "-" + root.exhale + "-" + root.hold-exhale;
    }

    // The ring size that the current phase animates towards.
    pure function phase-target(ph: int) -> length {
        return ph == 0 || ph == 1 ? 238px : 150px;
    }

    pure function phase-duration(ph: int) -> int {
        if ph == 0 { return root.inhale; }
        if ph == 1 { return root.hold-inhale; }
        if ph == 2 { return root.exhale; }
        return root.hold-exhale;
    }

    pure function phase-label(ph: int) -> string {
        if ph == 0 { return "INHALE"; }
        if ph == 1 { return "HOLD"; }
        if ph == 2 { return "EXHALE"; }
        return "HOLD";
    }

    pure function phase-color(ph: int) -> color {
        if ph == 0 { return #4facfe; }
        if ph == 1 { return #fce38a; }
        if ph == 2 { return #69f0ae; }
        return #fce38a;
    }

    // Skip over zero-second phases (e.g. the holds in 6-0-2-0).
    pure function next-active-phase(ph: int) -> int {
        if root.phase-duration(Math.mod(ph + 1, 4)) > 0 {
            return Math.mod(ph + 1, 4);
        }
        if root.phase-duration(Math.mod(ph + 2, 4)) > 0 {
            return Math.mod(ph + 2, 4);
        }
        if root.phase-duration(Math.mod(ph + 3, 4)) > 0 {
            return Math.mod(ph + 3, 4);
        }
        return ph;
    }

    // Phase -> cue. Silent for the zero-second phases that get skipped.
    function emit-phase-sound(ph: int) {
        if root.phase-duration(ph) <= 0 {
            return;
        }
        if ph == 0 {
            root.play-sound(Sound.breath-in);
        } else if ph == 2 {
            root.play-sound(Sound.breath-out);
        } else {
            root.play-sound(Sound.hold);
        }
    }

    function enter-phase(ph: int) {
        root.phase = ph;
        root.phase-seconds = root.phase-duration(ph);
        root.ring-size = root.phase-target(ph);
        root.emit-phase-sound(ph);
    }

    function start-session() {
        root.finished = false;
        root.running = true;
        root.phase = 0;
        root.phase-seconds = root.phase-duration(0);
        root.remaining = root.minutes * 60;
        root.session-total = root.remaining;
        root.ring-size = 150px;
        root.arming = true;
        root.screen = Screen.session;
    }

    function close-session() {
        root.running = false;
        root.arming = false;
        root.screen = Screen.start;
    }

    function tick() {
        if root.remaining <= 1 {
            root.remaining = 0;
            root.running = false;
            root.finished = true;
            root.play-sound(Sound.ding);
            return;
        }

        root.remaining -= 1;
        if root.phase-seconds <= 1 {
            root.enter-phase(root.next-active-phase(root.phase));
        } else {
            root.phase-seconds -= 1;
        }
    }

    // Hand the current settings to the host.
    function persist() {
        root.settings-changed({
            minutes: root.minutes,
            inhale: root.inhale,
            hold-inhale: root.hold-inhale,
            exhale: root.exhale,
            hold-exhale: root.hold-exhale,
            scent-on: root.scent-on,
        });
    }

    // Set by any persisted change, cleared by the timer below. Saving one turn
    // later coalesces actions that touch several fields (picking a preset
    // rewrites all four steps) into a single save, which matters for a flash
    // store.
    property <bool> settings-dirty: false;

    Timer {
        interval: 1ms;
        running: root.settings-dirty;
        triggered() => {
            root.settings-dirty = false;
            root.persist();
        }
    }

    changed minutes => { root.settings-dirty = true; }
    changed inhale => { root.settings-dirty = true; }
    changed hold-inhale => { root.settings-dirty = true; }
    changed exhale => { root.settings-dirty = true; }
    changed hold-exhale => { root.settings-dirty = true; }
    changed scent-on => { root.settings-dirty = true; }

    // One tick per second while a session is running.
    Timer {
        interval: 1s;
        running: root.running && root.screen == Screen.session;
        triggered() => { root.tick(); }
    }

    // Small delay so the first inhale animates from the small ring instead of
    // snapping to full size when the session screen is instantiated.
    Timer {
        interval: 120ms;
        // Gated on the screen too: if the host navigates away before the
        // arming delay elapses, the first inhale must not fire.
        running: root.arming && root.screen == Screen.session;
        triggered() => {
            root.arming = false;
            root.ring-size = root.phase-target(root.phase);
            // The first inhale starts here, not when `start-session` runs.
            root.emit-phase-sound(root.phase);
        }
    }

    if root.screen == Screen.start : StartScreen {
        pattern-name: root.preset-name();
        pattern-numbers: root.rhythm();
        start-clicked => { root.start-session(); }
        customize-clicked => { root.screen = Screen.customize; }
    }

    if root.screen == Screen.session : SessionScreen {
        pattern-name: root.preset-name();
        remaining: root.remaining;
        total: root.session-total;
        phase: root.phase;
        phase-seconds: root.phase-seconds;
        ring-size: root.ring-size;
        anim-duration: root.finished ? 0ms : root.phase-duration(root.phase) * 1000ms;
        phase-label: root.phase-label(root.phase);
        phase-color: root.phase-color(root.phase);
        finished: root.finished;
        close-clicked => { root.close-session(); }
    }

    if root.screen == Screen.customize : CustomizeScreen {
        minutes <=> root.minutes;
        inhale <=> root.inhale;
        hold-inhale <=> root.hold-inhale;
        exhale <=> root.exhale;
        hold-exhale <=> root.hold-exhale;
        patterns: root.patterns;
        scent-on <=> root.scent-on;
        matched-pattern: root.preset-index();
        preset-name: root.preset-name();
        back-clicked => { root.screen = Screen.start; }
    }
}
